{
  "description": "Reset the demo: remove every request, entitlement, review, and event, load the demo dataset again, and record a reset event. Fired only from the Reset demo data action in the rail, after the operator confirms; not listed in any agent's tools.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "runningLabel": "Resetting the demo data",
  "completedLabel": "Reset the demo data",
  "timeout": 120000,
  "execution": "durable",
  "uses": {
    "tools": [
      "store__entitlements__list",
      "store__entitlements__remove",
      "store__entitlements__set",
      "store__requests__list",
      "store__requests__remove",
      "store__requests__set",
      "store__reviews__list",
      "store__reviews__remove",
      "store__reviews__set",
      "store__events__list",
      "store__events__remove",
      "store__events__set"
    ]
  },
  "triggers": [{ "kind": "invoke" }]
}
